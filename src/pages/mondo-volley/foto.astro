---
import Layout from '../../layouts/Layout.astro';
import HeroSection from '../../components/HeroSection.astro';
import { getImage } from 'astro:assets';
import { getFotoPerEdizione } from '../../utils/mondo-volley-foto';
import edizioniData from '../../data/mondo-volley-edizioni.json';

const fotoPerEdizione = getFotoPerEdizione();

const anni = [...new Set([
  ...edizioniData.map((e) => e.anno),
  ...fotoPerEdizione.map((e) => e.anno),
])].sort((a, b) => b.localeCompare(a));

const medaglie = ['🥇', '🥈', '🥉'];

const edizioni = await Promise.all(
  anni.map(async (anno) => {
    const info = edizioniData.find((e) => e.anno === anno);
    const fotoRaw = fotoPerEdizione.find((e) => e.anno === anno)?.foto ?? [];
    const foto = await Promise.all(
      fotoRaw.map(async (img) => ({
        thumb: await getImage({ src: img, width: 640, format: 'webp' }),
        large: await getImage({ src: img, width: 1600, format: 'webp' }),
      }))
    );
    return {
      anno,
      data: info?.data,
      podio: (info?.podio ?? []).filter((p) => p.squadra.trim() !== ''),
      linkRisultati: info?.linkRisultati || null,
      foto,
    };
  })
);
---

<Layout title="Mondo Volley – Foto" description="Le foto e il podio delle edizioni di Mondo Volley, il torneo amatoriale di green volley di Zugliano.">

  <HeroSection
    title="Le foto del torneo"
    subtitle="I momenti più belli di Mondo Volley: partite, premiazioni e tanta festa all'Area Sportiva di Zugliano."
    tag="Mondo Volley"
    variant="accent"
  />

  {edizioni.map((ed, i) => (
    <section class={`section${i % 2 === 1 ? ' section--alt' : ''}`}>
      <div class="container">
        <div class="section-header">
          <h2>Edizione {ed.anno}</h2>
          {ed.data && <p class="section-header__subtitle">{ed.data} · Area Sportiva di Zugliano</p>}
        </div>

        {ed.podio.length > 0 && (
          <div class="podio">
            {ed.podio.map((p) => (
              <div class={`podio-card podio-card--${p.posizione}`}>
                <span class="podio-card__medal">{medaglie[p.posizione - 1] ?? '🏅'}</span>
                <span class="podio-card__pos">{p.posizione}° posto</span>
                <span class="podio-card__team">{p.squadra}</span>
              </div>
            ))}
          </div>
        )}

        {ed.linkRisultati && (
          <p class="risultati-link">
            <a href={ed.linkRisultati} class="btn btn--outline" target="_blank" rel="noopener">
              Tutti i risultati dell'edizione {ed.anno}
            </a>
          </p>
        )}

        {ed.foto.length > 0 ? (
          <div class="gallery gallery--foto">
            {ed.foto.map((f, n) => (
              <a
                href={f.large.src}
                class="gallery__item"
                data-lightbox={`edizione-${ed.anno}`}
                aria-label={`Ingrandisci foto ${n + 1} – Mondo Volley ${ed.anno}`}
              >
                <img
                  src={f.thumb.src}
                  width={f.thumb.attributes.width}
                  height={f.thumb.attributes.height}
                  alt={`Mondo Volley ${ed.anno} – foto ${n + 1}`}
                  loading="lazy"
                  decoding="async"
                  class="gallery__img"
                />
              </a>
            ))}
          </div>
        ) : (
          <p class="foto-in-arrivo">📷 Le foto di questa edizione sono in arrivo!</p>
        )}
      </div>
    </section>
  ))}

  <section class="section">
    <div class="container">
      <a href="/mondo-volley" class="btn btn--primary">← Torna alla pagina del torneo</a>
    </div>
  </section>

  <dialog id="lightbox" class="lightbox" aria-label="Foto ingrandita">
    <button type="button" class="lightbox__close" data-lb-close aria-label="Chiudi">✕</button>
    <button type="button" class="lightbox__nav lightbox__nav--prev" data-lb-prev aria-label="Foto precedente">‹</button>
    <img class="lightbox__img" id="lightbox-img" src="" alt="Foto ingrandita" />
    <button type="button" class="lightbox__nav lightbox__nav--next" data-lb-next aria-label="Foto successiva">›</button>
  </dialog>

</Layout>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')];

  let gruppo: HTMLAnchorElement[] = [];
  let indice = 0;

  function mostra(i: number) {
    indice = (i + gruppo.length) % gruppo.length;
    img.src = gruppo[indice].href;
  }

  links.forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      gruppo = links.filter((l) => l.dataset.lightbox === link.dataset.lightbox);
      mostra(gruppo.indexOf(link));
      dialog.showModal();
    });
  });

  dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => mostra(indice - 1));
  dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => mostra(indice + 1));

  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') mostra(indice - 1);
    if (e.key === 'ArrowRight') mostra(indice + 1);
  });

  // Chiudi cliccando fuori dalla foto
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  /* Podio */
  .podio {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .podio-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 1.25rem 2rem;
    min-width: 180px;
  }

  .podio-card--1 {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }

  .podio-card__medal {
    font-size: 2rem;
    line-height: 1;
  }

  .podio-card__pos {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .podio-card__team {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-primary-dark);
    text-align: center;
  }

  .risultati-link {
    text-align: center;
    margin-bottom: 2rem;
  }

  /* Galleria */
  .gallery--foto {
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }

  .gallery__item {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    aspect-ratio: 4 / 3;
    background: var(--color-border);
  }

  .gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.25s;
  }

  .gallery__item:hover .gallery__img {
    transform: scale(1.04);
  }

  .foto-in-arrivo {
    text-align: center;
    color: var(--color-text-muted);
    font-style: italic;
    padding: 2rem 0;
  }

  /* Lightbox */
  .lightbox {
    border: none;
    padding: 0;
    background: transparent;
    max-width: 92vw;
    max-height: 92vh;
    overflow: visible;
    /* il reset globale azzera il margin: auto con cui il browser centra i dialog */
    margin: auto;
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.85);
  }

  .lightbox__img {
    max-width: 92vw;
    max-height: 88vh;
    display: block;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }

  .lightbox__close,
  .lightbox__nav {
    position: fixed;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    border: none;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
    z-index: 10;
  }

  .lightbox__close:hover,
  .lightbox__nav:hover {
    background: rgba(0, 0, 0, 0.8);
  }

  .lightbox__close {
    top: 1rem;
    right: 1rem;
  }

  .lightbox__nav {
    top: 50%;
    transform: translateY(-50%);
    font-size: 2rem;
  }

  .lightbox__nav--prev {
    left: 1rem;
  }

  .lightbox__nav--next {
    right: 1rem;
  }

  @media (max-width: 600px) {
    .podio-card {
      min-width: 140px;
      padding: 1rem 1.25rem;
      flex: 1;
    }
  }
</style>
